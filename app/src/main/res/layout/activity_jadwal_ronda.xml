<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    tools:context=".JadwalRondaActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Tombol Back -->
        <ImageButton
            android:id="@+id/btnBackJadwal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_back_button_blue"
            android:contentDescription="@string/cd_kembali"
            android:padding="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back_arrow"
            app:tint="@android:color/white" />

        <!-- Judul -->
        <TextView
            android:id="@+id/textTitleJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Jadwal Ronda"
            android:textColor="@color/blue"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Kartu biru utama -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardTanggalDanJadwal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/blue"
            app:cardCornerRadius="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textTitleJadwal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- BAR PILIH TANGGAL -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Tombol tanggal sebelumnya -->
                    <ImageButton
                        android:id="@+id/btnPrevDate"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@android:color/white"
                        android:contentDescription="@string/cd_kembali"
                        android:padding="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:srcCompat="@drawable/ic_back_arrow"
                        app:tint="@color/blue" />

                    <!-- Teks tanggal -->
                    <TextView
                        android:id="@+id/textTanggalPilihan"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@android:color/white"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Senin, 24 November"
                        android:textColor="@color/blue"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/btnPrevDate"
                        app:layout_constraintEnd_toStartOf="@id/btnNextDate"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- Tombol tanggal berikutnya -->
                    <ImageButton
                        android:id="@+id/btnNextDate"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/rounded_button"
                        android:backgroundTint="@android:color/white"
                        android:contentDescription="@string/cd_kembali"
                        android:padding="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:srcCompat="@drawable/ic_back_arrow"
                        app:tint="@color/blue"
                        android:rotation="180" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Kartu putih POS KAMU + daftar jadwal -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPosDanDaftar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textPosKamu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pos Kamu: RT 01 / Pos 01 (Utara)"
                            android:textColor="@color/blue"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                        <!-- ITEM 1 - hijau (jadwal kamu) -->
                        <LinearLayout
                            android:id="@+id/itemJadwal1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_schedule_item_selected"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/textNama1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Muhammad Fikri"
                                    android:textColor="@android:color/black"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/textIdJadwal1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID Jadwal: 720420"
                                    android:textColor="@android:color/black"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textJam1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="19:00 - 5:00"
                                android:textColor="@android:color/black"
                                android:textStyle="normal" />
                        </LinearLayout>

                        <!-- ITEM 2 - abu abu -->
                        <LinearLayout
                            android:id="@+id/itemJadwal2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_schedule_item_normal"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ahmad Muzaky"
                                    android:textColor="@android:color/black"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID Jadwal: 720421"
                                    android:textColor="@android:color/black"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="19:00 - 5:00"
                                android:textColor="@android:color/black"
                                android:textStyle="normal" />
                        </LinearLayout>

                        <!-- ITEM 3 - abu abu -->
                        <LinearLayout
                            android:id="@+id/itemJadwal3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/bg_schedule_item_normal"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Iqbal Febrian"
                                    android:textColor="@android:color/black"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ID Jadwal: 720422"
                                    android:textColor="@android:color/black"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="19:00 - 5:00"
                                android:textColor="@android:color/black"
                                android:textStyle="normal" />
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Kembali di bawah -->
        <Button
            android:id="@+id/btnKembaliJadwal"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/rounded_button"
            android:backgroundTint="@color/blue"
            android:text="Kembali"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTanggalDanJadwal"
            app:layout_constraintVertical_bias="0.813" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
